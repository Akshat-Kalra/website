---
import { cn } from "../lib/utils";

type Props = {
  href: string;
  variant?: "primary" | "secondary";
  className?: string;
};

const { href, variant = "primary", className } = Astro.props;
---

<a
  href={href}
  class={cn(
    "inline-flex items-center justify-center rounded-full px-4 py-2 text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-zinc-400 focus:ring-offset-2",
    variant === "primary" &&
      "bg-zinc-50 text-zinc-900 hover:bg-zinc-200",
    variant === "secondary" &&
      "bg-zinc-800 text-zinc-50 hover:bg-zinc-700",
    className
  )}
>
  <slot />
</a>
